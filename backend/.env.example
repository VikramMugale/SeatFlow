NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://seatflow:seatflow_secret@localhost:5432/seatflow

# MongoDB
MONGODB_URI=mongodb://localhost:27017/seatflow

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=seatflow_jwt_access_secret_change_in_prod_32chars
JWT_REFRESH_SECRET=seatflow_jwt_refresh_secret_change_in_prod_32chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Seat lock
SEAT_LOCK_TTL_SECONDS=300

# Payment (Stripe-style)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# CORS
CORS_ORIGIN=http://localhost:4200

# Logging
LOG_LEVEL=info
